{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "42rem",
			"wideSize": "72rem"
		},
		"color": {
			"palette": [
				{
					"slug": "text",
					"name": "Text",
					"color": "#1a1a1a"
				},
				{
					"slug": "heading",
					"name": "Heading text",
					"color": "#1a1a1a"
				},
				{
					"slug": "background",
					"name": "Background",
					"color": "#f6f6f6"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#ffffff"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#595959"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#262626"
				},
				{
					"slug": "link",
					"name": "Link text",
					"color": "#363636"
				},
				{
					"slug": "focus",
					"name": "Keyboard focus",
					"color": "#484848"
				},
				{
					"slug": "border",
					"name": "Border",
					"color": "#d4d4d4"
				},
				{
					"slug": "on-accent",
					"name": "On accent",
					"color": "#ffffff"
				},
				{
					"slug": "accent-hover",
					"name": "Accent hover",
					"color": "#111111"
				}
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "archivo",
					"name": "Archivo",
					"fontFamily": "\"Archivo\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Archivo",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/archivo.woff2"
							]
						},
						{
							"fontFamily": "Archivo",
							"fontWeight": "100 900",
							"fontStyle": "italic",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/archivo-italic.woff2"
							]
						}
					]
				},
				{
					"slug": "bricolage-grotesque",
					"name": "Bricolage Grotesque",
					"fontFamily": "\"Bricolage Grotesque\", \"Arial Narrow\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Bricolage Grotesque",
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/bricolage-grotesque.woff2"
							]
						}
					]
				},
				{
					"slug": "jetbrains-mono",
					"name": "JetBrains Mono",
					"fontFamily": "\"JetBrains Mono\", ui-monospace, monospace",
					"fontFace": [
						{
							"fontFamily": "JetBrains Mono",
							"fontWeight": "100 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/jetbrains-mono.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "body",
					"name": "Body",
					"size": "1rem",
					"fluid": false
				},
				{
					"slug": "lead",
					"name": "Lead",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.5rem"
					}
				},
				{
					"slug": "subheading",
					"name": "Subheading",
					"size": "1.5rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.75rem"
					}
				},
				{
					"slug": "minor-heading",
					"name": "Minor heading",
					"size": "1.125rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"slug": "heading",
					"name": "Heading",
					"size": "2rem",
					"fluid": {
						"min": "1.5rem",
						"max": "2.75rem"
					}
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "3rem",
					"fluid": {
						"min": "2.25rem",
						"max": "4.5rem"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "xs",
					"name": "Extra small",
					"size": "0.5rem"
				},
				{
					"slug": "s",
					"name": "Small",
					"size": "0.75rem"
				},
				{
					"slug": "m",
					"name": "Medium",
					"size": "1rem"
				},
				{
					"slug": "l",
					"name": "Large",
					"size": "2rem"
				},
				{
					"slug": "xl",
					"name": "Extra large",
					"size": "4rem"
				}
			]
		},
		"custom": {
			"brand": {
				"body": "var(--wp--preset--font-family--archivo)",
				"heading": "var(--wp--preset--font-family--bricolage-grotesque)"
			},
			"radius": {
				"default": "0.375rem"
			},
			"lineHeight": {
				"body": "1.6",
				"heading": "1.2"
			},
			"shadow": {
				"card": "0 0.25rem 1rem rgb(0 0 0 / 0.08)"
			},
			"focus": {
				"width": "3px",
				"offset": "2px",
				"color": "var(--wp--preset--color--focus)"
			},
			"layout": {
				"gridMin": "16rem",
				"mediaMin": "20rem"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--custom--brand--body)",
			"lineHeight": "var(--wp--custom--line-height--body)",
			"fontSize": "var(--wp--preset--font-size--body)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--link)"
				}
			},
			"h1": {
				"color": {
					"text": "var(--wp--preset--color--heading)"
				},
				"typography": {
					"fontFamily": "var(--wp--custom--brand--heading)",
					"fontSize": "var(--wp--preset--font-size--display)",
					"lineHeight": "var(--wp--custom--line-height--heading)",
					"fontWeight": "600",
					"letterSpacing": "-0.045em"
				}
			},
			"h2": {
				"color": {
					"text": "var(--wp--preset--color--heading)"
				},
				"typography": {
					"fontFamily": "var(--wp--custom--brand--heading)",
					"fontSize": "var(--wp--preset--font-size--heading)",
					"lineHeight": "var(--wp--custom--line-height--heading)",
					"fontWeight": "700",
					"letterSpacing": "-0.045em"
				}
			},
			"h3": {
				"color": {
					"text": "var(--wp--preset--color--heading)"
				},
				"typography": {
					"fontFamily": "var(--wp--custom--brand--heading)",
					"fontSize": "var(--wp--preset--font-size--subheading)",
					"lineHeight": "var(--wp--custom--line-height--heading)",
					"fontWeight": "700",
					"letterSpacing": "-0.045em"
				}
			},
			"h4": {
				"color": {
					"text": "var(--wp--preset--color--heading)"
				},
				"typography": {
					"fontFamily": "var(--wp--custom--brand--heading)",
					"fontSize": "var(--wp--preset--font-size--minor-heading)",
					"lineHeight": "var(--wp--custom--line-height--heading)",
					"fontWeight": "700"
				}
			},
			"h5": {
				"color": {
					"text": "var(--wp--preset--color--heading)"
				},
				"typography": {
					"fontFamily": "var(--wp--custom--brand--heading)",
					"fontSize": "var(--wp--preset--font-size--body)",
					"lineHeight": "var(--wp--custom--line-height--heading)",
					"fontWeight": "700"
				}
			},
			"h6": {
				"color": {
					"text": "var(--wp--preset--color--heading)"
				},
				"typography": {
					"fontFamily": "var(--wp--custom--brand--heading)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"lineHeight": "var(--wp--custom--line-height--heading)",
					"fontWeight": "700"
				}
			}
		}
	}
}
