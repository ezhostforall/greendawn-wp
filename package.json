{
  "name": "greendawn",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Reusable WordPress starter theme and development environment.",
  "license": "GPL-2.0-or-later",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/validate-manifest.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:php": "composer run lint",
    "test:php": "composer run test",
    "test:node": "node --test \"tests/node/*.test.mjs\"",
    "test:e2e": "playwright test --project=chromium",
    "test:visual": "playwright test --project=visual",
    "test:staging": "playwright test --project=staging",
    "check": "pnpm lint && pnpm typecheck && pnpm test:node && pnpm build && pnpm lint:php && pnpm test:php",
    "init": "node scripts/init-project.mjs",
    "package": "node scripts/package.mjs",
    "test:wp:setup": "bash tests/integration/setup.sh",
    "test:wp:down": "docker compose -f tests/integration/compose.yml down -v --remove-orphans"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
